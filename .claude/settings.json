{
  "env": {
    "SCOPE_SENTINEL": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -r \"$HOME/.secrets\" ] && . \"$HOME/.secrets\" >/dev/null 2>&1; exec python3 \"$CLAUDE_PROJECT_DIR/skill_router.py\" --host claude hook'",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -r \"$HOME/.secrets\" ] && . \"$HOME/.secrets\" >/dev/null 2>&1; exec python3 \"$CLAUDE_PROJECT_DIR/scope_sentinel.py\" hook' || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
