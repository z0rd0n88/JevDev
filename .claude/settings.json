{
  "env": {
    "SCOPE_SENTINEL": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/with_jev_key.sh\" python3 \"${CLAUDE_PROJECT_DIR}/skill_router.py\" --host claude hook",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/with_jev_key.sh\" python3 \"${CLAUDE_PROJECT_DIR}/scope_sentinel.py\" hook || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
