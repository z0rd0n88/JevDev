{
  "description": "Jev hooks. Each one exits at once unless JEV_HOOKS names it; see plugin/README.md.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugin/jev-hook.sh\" router", "timeout": 90 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugin/jev-hook.sh\" sentinel || true", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugin/jev-hook.sh\" sentinel || true", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugin/jev-hook.sh\" advisor || true", "timeout": 45 }
        ]
      }
    ]
  }
}
